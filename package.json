{
  "name": "school-bell-system",
  "productName": "School Bell System",
  "version": "2.2.0",
  "description": "A desktop program that plays school bell sounds automatically at scheduled times.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64 --ia32 --publish never",
    "build:win64": "electron-builder --win --x64 --publish never",
    "build:win32": "electron-builder --win --ia32 --publish never",
    "dist": "electron-builder --win --x64 --ia32 --publish never"
  },
  "author": "Dandelion System",
  "license": "Freeware",
  "devDependencies": {
    "electron": "^22.3.27",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.dandelionsystem.schoolbell",
    "productName": "School Bell System",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis" }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SchoolBellSystem-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "School Bell System"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "shared/**",
      { "from": "src/SchoolBell/sound", "to": "sound", "filter": ["**/*.mp3","**/*.wav","**/*.ogg"] },
      "build/icon.png",
      "!**/*.map",
      "!**/{.git,.github,test,docs,src,wiki}/**"
    ]
  },
  "allowScripts": {
    "electron@22.3.27": true
  }
}
